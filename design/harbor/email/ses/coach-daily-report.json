{
  "TemplateName": "coach-daily-report",
  "TemplateContent": {
    "Subject": "Today: {{{lessonCount}}} lessons, {{{checkedInCount}}} checked in{{#if pending}}, {{{pendingCount}}} not recorded{{/if}}",
    "Html": "<!DOCTYPE html>\n<html lang=\"en\" xmlns=\"http://www.w3.org/1999/xhtml\" xmlns:v=\"urn:schemas-microsoft-com:vml\" xmlns:o=\"urn:schemas-microsoft-com:office:office\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"x-apple-disable-message-reformatting\">\n<meta name=\"format-detection\" content=\"telephone=no, date=no, address=no, email=no\">\n<meta name=\"color-scheme\" content=\"light\">\n<meta name=\"supported-color-schemes\" content=\"light\">\n<title>Today: {{lessonCount}} lessons, {{checkedInCount}} checked in{{#if pending}}, {{pendingCount}} not recorded{{/if}}</title>\n<!--[if mso]><noscript><xml><o:OfficeDocumentSettings><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml></noscript><![endif]-->\n<link href=\"https://fonts.googleapis.com/css2?family=Figtree:wght@400;700;800&display=swap\" rel=\"stylesheet\">\n<style>\n  :root { color-scheme: light; supported-color-schemes: light; }\n  body { margin: 0; padding: 0; width: 100% !important; -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }\n  table { border-collapse: collapse; mso-table-lspace: 0; mso-table-rspace: 0; }\n  a { color: #0E6C68; }\n  @media (max-width: 620px) {\n    .bb-pad { padding-left: 20px !important; padding-right: 20px !important; }\n    .bb-h1 { font-size: 24px !important; }\n    .bb-btn { width: 100% !important; }\n    .bb-btn a { display: block !important; }\n  }\n</style>\n<!--[if mso]><style>body, table, td, p, a, h1, h2, div { font-family: Arial, sans-serif !important; }</style><![endif]-->\n</head>\n<body style=\"margin:0;padding:0;background:#F7F3EC\">\n<div style=\"display:none;font-size:1px;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;mso-hide:all\">{{#if pending}}{{pendingCount}} not recorded yet.{{else}}Everything is recorded.{{/if}}&#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; </div>\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" bgcolor=\"#F7F3EC\" style=\"background:#F7F3EC\"><tr><td align=\"center\" style=\"padding:24px 12px 32px\">\n<!--[if mso]><table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr><td><![endif]-->\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"max-width:600px\">\n  <tr><td style=\"padding:0 8px 16px\">\n    <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" ><tr>\n      <td width=\"40\" height=\"40\" align=\"center\" valign=\"middle\" bgcolor=\"#0E6C68\" style=\"width:40px;height:40px;border-radius:50%;background:#0E6C68;font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:15px;font-weight:800;color:#FFFFFF\">BB</td>\n      <td style=\"padding-left:12px\">\n        <div style=\"font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:17px;line-height:1.2;font-weight:800;color:#1E292D\">BladeBook</div>\n        <div style=\"font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:14px;line-height:1.3;color:#5F6966\">For coaches</div>\n      </td></tr></table>\n  </td></tr>\n  <tr><td>\n    <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" bgcolor=\"#FFFDF9\" style=\"background:#FFFDF9;border:1px solid #E7DFD2;border-radius:20px;border-collapse:separate\"><tr>\n    <td class=\"bb-pad\" style=\"padding:32px 36px 14px\">\n      <div style=\"font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:13px;line-height:1.3;font-weight:800;letter-spacing:1.2px;text-transform:uppercase;color:#A8432D;padding-bottom:8px\">Daily report · {{today}}</div>\n      <h1 class=\"bb-h1\" style=\"margin:0 0 22px;font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:27px;line-height:1.2;font-weight:800;letter-spacing:-0.4px;color:#1E292D\">{{#if pending}}{{pendingCount}} not recorded yet{{else}}Everything is recorded{{/if}}</h1>\n      <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"margin:0 0 14px\"><tr><td class=\"bb-stat\" width=\"25%\" valign=\"top\" style=\"padding:0 8px 8px 0\">\n      <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" bgcolor=\"#F2ECE2\" style=\"background:#F2ECE2;border-radius:12px;border-collapse:separate\"><tr><td style=\"padding:12px 12px 10px\">\n      <div style=\"font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:26px;line-height:1.1;font-weight:800;color:#1E292D\">{{lessonCount}}</div>\n      <div style=\"font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:14px;line-height:1.3;color:#5F6966;padding-top:4px\">Lessons</div></td></tr></table></td><td class=\"bb-stat\" width=\"25%\" valign=\"top\" style=\"padding:0 8px 8px 0\">\n      <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" bgcolor=\"#F2ECE2\" style=\"background:#F2ECE2;border-radius:12px;border-collapse:separate\"><tr><td style=\"padding:12px 12px 10px\">\n      <div style=\"font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:26px;line-height:1.1;font-weight:800;color:#1E292D\">{{checkedInCount}}</div>\n      <div style=\"font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:14px;line-height:1.3;color:#5F6966;padding-top:4px\">Checked in</div></td></tr></table></td><td class=\"bb-stat\" width=\"25%\" valign=\"top\" style=\"padding:0 8px 8px 0\">\n      <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" bgcolor=\"#F2ECE2\" style=\"background:#F2ECE2;border-radius:12px;border-collapse:separate\"><tr><td style=\"padding:12px 12px 10px\">\n      <div style=\"font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:26px;line-height:1.1;font-weight:800;color:#1E292D\">{{noShowCount}}</div>\n      <div style=\"font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:14px;line-height:1.3;color:#5F6966;padding-top:4px\">No-show</div></td></tr></table></td><td class=\"bb-stat\" width=\"25%\" valign=\"top\" style=\"padding:0 0px 8px 0\">\n      <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" bgcolor=\"#F2ECE2\" style=\"background:#F2ECE2;border-radius:12px;border-collapse:separate\"><tr><td style=\"padding:12px 12px 10px\">\n      <div style=\"font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:26px;line-height:1.1;font-weight:800;color:#1E292D\">{{pendingCount}}</div>\n      <div style=\"font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:14px;line-height:1.3;color:#5F6966;padding-top:4px\">Not recorded</div></td></tr></table></td></tr></table>\n      {{#if pending}}<h2 style=\"margin:26px 0 10px;font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:18px;line-height:1.3;font-weight:800;color:#1E292D\">Not recorded</h2>{{#each pending}}<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" bgcolor=\"#EFF7F5\" style=\"margin:0 0 8px;background:#EFF7F5;border:1px solid #BEDDD9;border-radius:12px;border-collapse:separate\"><tr>\n      <td valign=\"middle\" style=\"padding:12px 16px\"><div style=\"font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:17px;line-height:1.35;font-weight:700;color:#1E292D;\">{{time}} · {{skater}}</div><div style=\"font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:15px;line-height:1.4;color:#46524F;padding-top:2px\">{{rink}}</div></td></tr></table>{{/each}}<div style=\"height:14px;line-height:14px;font-size:14px\">&nbsp;</div><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" bgcolor=\"#FCEFD9\" style=\"margin:0 0 22px;background:#FCEFD9;border:1px solid #EDC98C;border-radius:14px;border-collapse:separate\"><tr>\n      <td style=\"padding:14px 18px;font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:16px;line-height:1.5;color:#874B07\">If you checked these in at the rink without signal, open the rinkside app where you have signal and they’ll send. Otherwise, record them on your lesson list.</td></tr></table><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" class=\"bb-btn\" style=\"margin:6px 0 24px;border-collapse:separate\"><tr><td align=\"center\" bgcolor=\"#0E6C68\" style=\"border-radius:999px;background:#0E6C68\">\n      <a href=\"{{rinksideUrl}}\" target=\"_blank\" style=\"display:inline-block;padding:13px 30px;border:2px solid #0E6C68;font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:18px;line-height:1.2;font-weight:800;color:#FFFFFF;text-decoration:none;border-radius:999px\">Open the rinkside app</a></td></tr></table><p style=\"margin:0 0 18px;font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:17px;line-height:1.55;color:#1E292D;font-size:15px;color:#5F6966\">Or record them on your <a href=\"{{lessonsUrl}}\" style=\"color:#0E6C68;font-weight:700\">lesson list</a>.</p>{{/if}}\n      {{#if checkedIn}}<h2 style=\"margin:26px 0 10px;font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:18px;line-height:1.3;font-weight:800;color:#1E292D\">Checked in</h2>{{#each checkedIn}}<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" bgcolor=\"#EFF7F5\" style=\"margin:0 0 8px;background:#EFF7F5;border:1px solid #BEDDD9;border-radius:12px;border-collapse:separate\"><tr>\n      <td valign=\"middle\" style=\"padding:12px 16px\"><div style=\"font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:17px;line-height:1.35;font-weight:700;color:#1E292D;\">{{time}} · {{skater}}</div></td></tr></table>{{/each}}<div style=\"height:14px;line-height:14px;font-size:14px\">&nbsp;</div>{{/if}}\n      {{#if noShow}}<h2 style=\"margin:26px 0 10px;font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:18px;line-height:1.3;font-weight:800;color:#1E292D\">No-show</h2>{{#each noShow}}<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" bgcolor=\"#EFF7F5\" style=\"margin:0 0 8px;background:#EFF7F5;border:1px solid #BEDDD9;border-radius:12px;border-collapse:separate\"><tr>\n      <td valign=\"middle\" style=\"padding:12px 16px\"><div style=\"font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:17px;line-height:1.35;font-weight:700;color:#1E292D;\">{{time}} · {{skater}}</div></td></tr></table>{{/each}}<div style=\"height:14px;line-height:14px;font-size:14px\">&nbsp;</div>{{/if}}\n    </td></tr></table>\n  </td></tr>\n  <tr><td style=\"padding:20px 12px 0\">\n    <p style=\"margin:0 0 8px;font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:14px;line-height:1.5;color:#5F6966\">This is an automatic email from BladeBook. Replies to it aren’t read.</p><p style=\"margin:0 0 8px;font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:14px;line-height:1.5;color:#5F6966\">You get it because you coach on BladeBook.</p>\n  </td></tr>\n</table>\n<!--[if mso]></td></tr></table><![endif]-->\n</td></tr></table>\n</body>\n</html>",
    "Text": "BladeBook For coaches\n\n{{#if pending}}{{{pendingCount}}} not recorded yet{{else}}Everything is recorded{{/if}}\n\nLessons: {{{lessonCount}}}\nChecked in: {{{checkedInCount}}}\nNo-show: {{{noShowCount}}}\nNot recorded: {{{pendingCount}}}\n\n{{#if pending}}Not recorded\n{{#each pending}}- {{{time}}} · {{{skater}}} · {{{rink}}}\n{{/each}}\n\nIf you checked these in at the rink without signal, open the rinkside app where you have signal and they’ll send. Otherwise, record them on your lesson list.\n\nOpen the rinkside app:\n{{{rinksideUrl}}}\n\nOr record them on your lesson list ({{{lessonsUrl}}}).\n\n{{/if}}{{#if checkedIn}}Checked in\n{{#each checkedIn}}- {{{time}}} · {{{skater}}}\n{{/each}}\n\n{{/if}}{{#if noShow}}No-show\n{{#each noShow}}- {{{time}}} · {{{skater}}}\n{{/each}}\n\n{{/if}}\n\n--\nThis is an automatic email from BladeBook. Replies to it aren’t read.\nYou get it because you coach on BladeBook.\n"
  }
}
