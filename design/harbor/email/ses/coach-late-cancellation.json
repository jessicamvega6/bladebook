{
  "TemplateName": "coach-late-cancellation",
  "TemplateContent": {
    "Subject": "Late cancellation: {{{skater}}}, {{{date}}} at {{{time}}}",
    "Html": "<!DOCTYPE html>\n<html lang=\"en\" xmlns=\"http://www.w3.org/1999/xhtml\" xmlns:v=\"urn:schemas-microsoft-com:vml\" xmlns:o=\"urn:schemas-microsoft-com:office:office\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"x-apple-disable-message-reformatting\">\n<meta name=\"format-detection\" content=\"telephone=no, date=no, address=no, email=no\">\n<meta name=\"color-scheme\" content=\"light\">\n<meta name=\"supported-color-schemes\" content=\"light\">\n<title>Late cancellation: {{skater}}, {{date}} at {{time}}</title>\n<!--[if mso]><noscript><xml><o:OfficeDocumentSettings><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml></noscript><![endif]-->\n<link href=\"https://fonts.googleapis.com/css2?family=Figtree:wght@400;700;800&display=swap\" rel=\"stylesheet\">\n<style>\n  :root { color-scheme: light; supported-color-schemes: light; }\n  body { margin: 0; padding: 0; width: 100% !important; -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }\n  table { border-collapse: collapse; mso-table-lspace: 0; mso-table-rspace: 0; }\n  a { color: #0E6C68; }\n  @media (max-width: 620px) {\n    .bb-pad { padding-left: 20px !important; padding-right: 20px !important; }\n    .bb-h1 { font-size: 24px !important; }\n    .bb-btn { width: 100% !important; }\n    .bb-btn a { display: block !important; }\n  }\n</style>\n<!--[if mso]><style>body, table, td, p, a, h1, h2, div { font-family: Arial, sans-serif !important; }</style><![endif]-->\n</head>\n<body style=\"margin:0;padding:0;background:#F7F3EC\">\n<div style=\"display:none;font-size:1px;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;mso-hide:all\">{{familyName}} cancelled inside your {{noticeHours}}-hour notice period.&#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; </div>\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" bgcolor=\"#F7F3EC\" style=\"background:#F7F3EC\"><tr><td align=\"center\" style=\"padding:24px 12px 32px\">\n<!--[if mso]><table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr><td><![endif]-->\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"max-width:600px\">\n  <tr><td style=\"padding:0 8px 16px\">\n    <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" ><tr>\n      <td width=\"40\" height=\"40\" align=\"center\" valign=\"middle\" bgcolor=\"#0E6C68\" style=\"width:40px;height:40px;border-radius:50%;background:#0E6C68;font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:15px;font-weight:800;color:#FFFFFF\">BB</td>\n      <td style=\"padding-left:12px\">\n        <div style=\"font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:17px;line-height:1.2;font-weight:800;color:#1E292D\">BladeBook</div>\n        <div style=\"font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:14px;line-height:1.3;color:#5F6966\">For coaches</div>\n      </td></tr></table>\n  </td></tr>\n  <tr><td>\n    <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" bgcolor=\"#FFFDF9\" style=\"background:#FFFDF9;border:1px solid #E7DFD2;border-radius:20px;border-collapse:separate\"><tr>\n    <td class=\"bb-pad\" style=\"padding:32px 36px 14px\">\n      <div style=\"font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:13px;line-height:1.3;font-weight:800;letter-spacing:1.2px;text-transform:uppercase;color:#A8432D;padding-bottom:8px\">Late cancellation</div>\n      <h1 class=\"bb-h1\" style=\"margin:0 0 22px;font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:27px;line-height:1.2;font-weight:800;letter-spacing:-0.4px;color:#1E292D\">{{skater}} cancelled {{date}} at {{time}}</h1>\n      <p style=\"margin:0 0 18px;font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:17px;line-height:1.55;color:#1E292D;\">{{familyName}} cancelled {{skater}}’s lesson on <b>{{date}} at {{time}}</b>, inside your {{noticeHours}}-hour notice period. You may charge a late cancellation fee.</p>\n      <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" bgcolor=\"#EFF7F5\" style=\"margin:0 0 22px;background:#EFF7F5;border:1px solid #BEDDD9;border-radius:14px;border-collapse:separate\"><tr>\n      <td valign=\"top\" style=\"padding:16px 12px 0px 18px;width:34%;font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:15px;line-height:1.4;color:#5F6966\">Lesson</td>\n      <td valign=\"top\" style=\"padding:16px 18px 0px 0;font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:17px;line-height:1.4;color:#1E292D\">{{date}} at {{time}}</td></tr><tr>\n      <td valign=\"top\" style=\"padding:8px 12px 0px 18px;width:34%;font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:15px;line-height:1.4;color:#5F6966\">Where</td>\n      <td valign=\"top\" style=\"padding:8px 18px 0px 0;font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:17px;line-height:1.4;color:#1E292D\">{{rink}}</td></tr><tr>\n      <td valign=\"top\" style=\"padding:8px 12px 0px 18px;width:34%;font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:15px;line-height:1.4;color:#5F6966\">Cancelled</td>\n      <td valign=\"top\" style=\"padding:8px 18px 0px 0;font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:17px;line-height:1.4;color:#1E292D\">{{cancelledAt}}</td></tr><tr>\n      <td valign=\"top\" style=\"padding:8px 12px 16px 18px;width:34%;font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:15px;line-height:1.4;color:#5F6966\">Family</td>\n      <td valign=\"top\" style=\"padding:8px 18px 16px 0;font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:17px;line-height:1.4;color:#1E292D\">{{familyName}}</td></tr></table>\n      <p style=\"margin:0 0 18px;font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:17px;line-height:1.55;color:#1E292D;\">{{#if sharedWith}}{{sharedWith}} keeps the lesson at their share.{{else}}The time is open for booking again.{{/if}}</p>\n      <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" class=\"bb-btn\" style=\"margin:6px 0 24px;border-collapse:separate\"><tr><td align=\"center\" bgcolor=\"#0E6C68\" style=\"border-radius:999px;background:#0E6C68\">\n      <a href=\"{{calendarUrl}}\" target=\"_blank\" style=\"display:inline-block;padding:13px 30px;border:2px solid #0E6C68;font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:18px;line-height:1.2;font-weight:800;color:#FFFFFF;text-decoration:none;border-radius:999px\">See your calendar</a></td></tr></table>\n    </td></tr></table>\n  </td></tr>\n  <tr><td style=\"padding:20px 12px 0\">\n    <p style=\"margin:0 0 8px;font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:14px;line-height:1.5;color:#5F6966\">This is an automatic email from BladeBook. Replies to it aren’t read.</p><p style=\"margin:0 0 8px;font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:14px;line-height:1.5;color:#5F6966\">You get it because you coach on BladeBook.</p>\n  </td></tr>\n</table>\n<!--[if mso]></td></tr></table><![endif]-->\n</td></tr></table>\n</body>\n</html>",
    "Text": "BladeBook For coaches\n\n{{{skater}}} cancelled {{{date}}} at {{{time}}}\n\n{{{familyName}}} cancelled {{{skater}}}’s lesson on {{{date}}} at {{{time}}}, inside your {{{noticeHours}}}-hour notice period. You may charge a late cancellation fee.\n\nLesson: {{{date}}} at {{{time}}}\nWhere: {{{rink}}}\nCancelled: {{{cancelledAt}}}\nFamily: {{{familyName}}}\n\n{{#if sharedWith}}{{{sharedWith}}} keeps the lesson at their share.{{else}}The time is open for booking again.{{/if}}\n\nSee your calendar:\n{{{calendarUrl}}}\n\n--\nThis is an automatic email from BladeBook. Replies to it aren’t read.\nYou get it because you coach on BladeBook.\n"
  }
}
