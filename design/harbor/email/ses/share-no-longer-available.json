{
  "TemplateName": "share-no-longer-available",
  "TemplateContent": {
    "Subject": "{{{inviterName}}}’s invitation is no longer available",
    "Html": "<!DOCTYPE html>\n<html lang=\"en\" xmlns=\"http://www.w3.org/1999/xhtml\" xmlns:v=\"urn:schemas-microsoft-com:vml\" xmlns:o=\"urn:schemas-microsoft-com:office:office\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"x-apple-disable-message-reformatting\">\n<meta name=\"format-detection\" content=\"telephone=no, date=no, address=no, email=no\">\n<meta name=\"color-scheme\" content=\"light\">\n<meta name=\"supported-color-schemes\" content=\"light\">\n<title>{{inviterName}}’s invitation is no longer available</title>\n<!--[if mso]><noscript><xml><o:OfficeDocumentSettings><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml></noscript><![endif]-->\n<link href=\"https://fonts.googleapis.com/css2?family=Figtree:wght@400;700;800&display=swap\" rel=\"stylesheet\">\n<style>\n  :root { color-scheme: light; supported-color-schemes: light; }\n  body { margin: 0; padding: 0; width: 100% !important; -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }\n  table { border-collapse: collapse; mso-table-lspace: 0; mso-table-rspace: 0; }\n  a { color: #0E6C68; }\n  @media (max-width: 620px) {\n    .bb-pad { padding-left: 20px !important; padding-right: 20px !important; }\n    .bb-h1 { font-size: 24px !important; }\n    .bb-btn { width: 100% !important; }\n    .bb-btn a { display: block !important; }\n  }\n</style>\n<!--[if mso]><style>body, table, td, p, a, h1, h2, div { font-family: Arial, sans-serif !important; }</style><![endif]-->\n</head>\n<body style=\"margin:0;padding:0;background:#F7F3EC\">\n<div style=\"display:none;font-size:1px;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;mso-hide:all\">Nothing was booked for {{skater}}.&#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; </div>\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" bgcolor=\"#F7F3EC\" style=\"background:#F7F3EC\"><tr><td align=\"center\" style=\"padding:24px 12px 32px\">\n<!--[if mso]><table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr><td><![endif]-->\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"max-width:600px\">\n  <tr><td style=\"padding:0 8px 16px\">\n    <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" ><tr>\n      <td width=\"40\" height=\"40\" align=\"center\" valign=\"middle\" bgcolor=\"#0E6C68\" style=\"width:40px;height:40px;border-radius:50%;background:#0E6C68;font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:15px;font-weight:800;color:#FFFFFF\">{{coachInitials}}</td>\n      <td style=\"padding-left:12px\">\n        <div style=\"font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:17px;line-height:1.2;font-weight:800;color:#1E292D\">Coach {{coachName}}</div>\n        <div style=\"font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:14px;line-height:1.3;color:#5F6966\">via BladeBook</div>\n      </td></tr></table>\n  </td></tr>\n  <tr><td>\n    <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" bgcolor=\"#FFFDF9\" style=\"background:#FFFDF9;border:1px solid #E7DFD2;border-radius:20px;border-collapse:separate\"><tr>\n    <td class=\"bb-pad\" style=\"padding:32px 36px 14px\">\n      <div style=\"font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:13px;line-height:1.3;font-weight:800;letter-spacing:1.2px;text-transform:uppercase;color:#A8432D;padding-bottom:8px\">Shared lesson</div>\n      <h1 class=\"bb-h1\" style=\"margin:0 0 22px;font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:27px;line-height:1.2;font-weight:800;letter-spacing:-0.4px;color:#1E292D\">{{#if oneLesson}}This invitation is no longer available{{else}}These dates are no longer available{{/if}}</h1>\n      <p style=\"margin:0 0 18px;font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:17px;line-height:1.55;color:#1E292D;\">Hi {{familyFirst}},</p>\n      <p style=\"margin:0 0 18px;font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:17px;line-height:1.55;color:#1E292D;\">{{inviterName}}’s invitation for {{skater}} to share {{#if oneLesson}}the lesson with Coach {{coachFirst}} on <b>{{date}} at {{time}}</b> is no longer available, so {{skater}} wasn’t added.{{else}}these lessons with Coach {{coachFirst}} is no longer available, so {{skater}} wasn’t added to them:{{/if}}</p>\n      {{#if oneLesson}}{{else}}{{#each lessons}}<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" bgcolor=\"#F2ECE2\" style=\"margin:0 0 8px;background:#F2ECE2;border:1px solid #E7DFD2;border-radius:12px;border-collapse:separate\"><tr>\n      <td valign=\"middle\" style=\"padding:12px 16px\"><div style=\"font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:17px;line-height:1.35;font-weight:700;color:#46524F;text-decoration:line-through;\">{{date}} · {{time}}</div></td></tr></table>{{/each}}<div style=\"height:14px;line-height:14px;font-size:14px\">&nbsp;</div>{{/if}}\n      <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" bgcolor=\"#EFF7F5\" style=\"margin:0 0 22px;background:#EFF7F5;border:1px solid #BEDDD9;border-radius:14px;border-collapse:separate\"><tr>\n      <td style=\"padding:14px 18px;font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:16px;line-height:1.5;color:#0A5350\">Nothing was booked for {{skater}}, and you won’t be charged.</td></tr></table>\n      <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" class=\"bb-btn\" style=\"margin:6px 0 24px;border-collapse:separate\"><tr><td align=\"center\" bgcolor=\"#FFFDF9\" style=\"border-radius:999px;background:#FFFDF9\">\n      <a href=\"{{bookUrl}}\" target=\"_blank\" style=\"display:inline-block;padding:13px 30px;border:2px solid #0E6C68;font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:18px;line-height:1.2;font-weight:800;color:#0E6C68;text-decoration:none;border-radius:999px\">Book a lesson</a></td></tr></table>\n    </td></tr></table>\n  </td></tr>\n  <tr><td style=\"padding:20px 12px 0\">\n    <p style=\"margin:0 0 8px;font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:14px;line-height:1.5;color:#5F6966\">Questions? Reply to this email and it goes straight to Coach {{coachFirst}}.</p><p style=\"margin:0 0 8px;font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:14px;line-height:1.5;color:#5F6966\">BladeBook sends lesson emails for Coach {{coachName}}. You get them because you have a BladeBook account with Coach {{coachFirst}}.</p>\n  </td></tr>\n</table>\n<!--[if mso]></td></tr></table><![endif]-->\n</td></tr></table>\n</body>\n</html>",
    "Text": "Coach {{{coachName}}} via BladeBook\n\n{{#if oneLesson}}This invitation is no longer available{{else}}These dates are no longer available{{/if}}\n\nHi {{{familyFirst}}},\n\n{{{inviterName}}}’s invitation for {{{skater}}} to share {{#if oneLesson}}the lesson with Coach {{{coachFirst}}} on {{{date}}} at {{{time}}} is no longer available, so {{{skater}}} wasn’t added.{{else}}these lessons with Coach {{{coachFirst}}} is no longer available, so {{{skater}}} wasn’t added to them:{{/if}}\n\n{{#if oneLesson}}{{else}}{{#each lessons}}- {{{date}}} · {{{time}}}\n{{/each}}\n\n{{/if}}Nothing was booked for {{{skater}}}, and you won’t be charged.\n\nBook a lesson:\n{{{bookUrl}}}\n\n--\nQuestions? Reply to this email and it goes straight to Coach {{{coachFirst}}}.\nBladeBook sends lesson emails for Coach {{{coachName}}}. You get them because you have a BladeBook account with Coach {{{coachFirst}}}.\n"
  }
}
