{
  "TemplateName": "skater-approved",
  "TemplateContent": {
    "Subject": "{{{skater}}} can now book lessons with Coach {{{coachFirst}}}",
    "Html": "<!DOCTYPE html>\n<html lang=\"en\" xmlns=\"http://www.w3.org/1999/xhtml\" xmlns:v=\"urn:schemas-microsoft-com:vml\" xmlns:o=\"urn:schemas-microsoft-com:office:office\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"x-apple-disable-message-reformatting\">\n<meta name=\"format-detection\" content=\"telephone=no, date=no, address=no, email=no\">\n<meta name=\"color-scheme\" content=\"light\">\n<meta name=\"supported-color-schemes\" content=\"light\">\n<title>{{skater}} can now book lessons with Coach {{coachFirst}}</title>\n<!--[if mso]><noscript><xml><o:OfficeDocumentSettings><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml></noscript><![endif]-->\n<link href=\"https://fonts.googleapis.com/css2?family=Figtree:wght@400;700;800&display=swap\" rel=\"stylesheet\">\n<style>\n  :root { color-scheme: light; supported-color-schemes: light; }\n  body { margin: 0; padding: 0; width: 100% !important; -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }\n  table { border-collapse: collapse; mso-table-lspace: 0; mso-table-rspace: 0; }\n  a { color: #0E6C68; }\n  @media (max-width: 620px) {\n    .bb-pad { padding-left: 20px !important; padding-right: 20px !important; }\n    .bb-h1 { font-size: 24px !important; }\n    .bb-btn { width: 100% !important; }\n    .bb-btn a { display: block !important; }\n  }\n</style>\n<!--[if mso]><style>body, table, td, p, a, h1, h2, div { font-family: Arial, sans-serif !important; }</style><![endif]-->\n</head>\n<body style=\"margin:0;padding:0;background:#F7F3EC\">\n<div style=\"display:none;font-size:1px;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;mso-hide:all\">Coach {{coachFirst}} approved {{skater}}. Booking is open.&#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; &#8199;&#847; </div>\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" bgcolor=\"#F7F3EC\" style=\"background:#F7F3EC\"><tr><td align=\"center\" style=\"padding:24px 12px 32px\">\n<!--[if mso]><table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr><td><![endif]-->\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"max-width:600px\">\n  <tr><td style=\"padding:0 8px 16px\">\n    <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" ><tr>\n      <td width=\"40\" height=\"40\" align=\"center\" valign=\"middle\" bgcolor=\"#0E6C68\" style=\"width:40px;height:40px;border-radius:50%;background:#0E6C68;font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:15px;font-weight:800;color:#FFFFFF\">{{coachInitials}}</td>\n      <td style=\"padding-left:12px\">\n        <div style=\"font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:17px;line-height:1.2;font-weight:800;color:#1E292D\">Coach {{coachName}}</div>\n        <div style=\"font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:14px;line-height:1.3;color:#5F6966\">via BladeBook</div>\n      </td></tr></table>\n  </td></tr>\n  <tr><td>\n    <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" bgcolor=\"#FFFDF9\" style=\"background:#FFFDF9;border:1px solid #E7DFD2;border-radius:20px;border-collapse:separate\"><tr>\n    <td class=\"bb-pad\" style=\"padding:32px 36px 14px\">\n      <div style=\"font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:13px;line-height:1.3;font-weight:800;letter-spacing:1.2px;text-transform:uppercase;color:#A8432D;padding-bottom:8px\">You’re all set</div>\n      <h1 class=\"bb-h1\" style=\"margin:0 0 22px;font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:27px;line-height:1.2;font-weight:800;letter-spacing:-0.4px;color:#1E292D\">Coach {{coachFirst}} approved {{skater}}</h1>\n      <p style=\"margin:0 0 18px;font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:17px;line-height:1.55;color:#1E292D;\">Hi {{familyFirst}},</p>\n      <p style=\"margin:0 0 18px;font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:17px;line-height:1.55;color:#1E292D;\">Good news: Coach {{coachName}} approved {{skater}}. You can see Coach {{coachFirst}}’s open times and book lessons now.</p>\n      <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" class=\"bb-btn\" style=\"margin:6px 0 24px;border-collapse:separate\"><tr><td align=\"center\" bgcolor=\"#0E6C68\" style=\"border-radius:999px;background:#0E6C68\">\n      <a href=\"{{bookUrl}}\" target=\"_blank\" style=\"display:inline-block;padding:13px 30px;border:2px solid #0E6C68;font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:18px;line-height:1.2;font-weight:800;color:#FFFFFF;text-decoration:none;border-radius:999px\">Book a lesson</a></td></tr></table>\n      <p style=\"margin:0 0 18px;font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:17px;line-height:1.55;color:#1E292D;font-size:15px;color:#5F6966\">Sign in with the email and password you used to sign up.</p>\n    </td></tr></table>\n  </td></tr>\n  <tr><td style=\"padding:20px 12px 0\">\n    <p style=\"margin:0 0 8px;font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:14px;line-height:1.5;color:#5F6966\">Questions? Reply to this email and it goes straight to Coach {{coachFirst}}.</p><p style=\"margin:0 0 8px;font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:14px;line-height:1.5;color:#5F6966\">BladeBook sends lesson emails for Coach {{coachName}}. You get them because you have a BladeBook account with Coach {{coachFirst}}.</p>\n  </td></tr>\n</table>\n<!--[if mso]></td></tr></table><![endif]-->\n</td></tr></table>\n</body>\n</html>",
    "Text": "Coach {{{coachName}}} via BladeBook\n\nCoach {{{coachFirst}}} approved {{{skater}}}\n\nHi {{{familyFirst}}},\n\nGood news: Coach {{{coachName}}} approved {{{skater}}}. You can see Coach {{{coachFirst}}}’s open times and book lessons now.\n\nBook a lesson:\n{{{bookUrl}}}\n\nSign in with the email and password you used to sign up.\n\n--\nQuestions? Reply to this email and it goes straight to Coach {{{coachFirst}}}.\nBladeBook sends lesson emails for Coach {{{coachName}}}. You get them because you have a BladeBook account with Coach {{{coachFirst}}}.\n"
  }
}
