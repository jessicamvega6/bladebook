<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.bladebook</groupId>
        <artifactId>bladebook-backend</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>core</artifactId>
    <name>BladeBook core</name>
    <description>Framework-free domain, DynamoDB access and events. Plain Java and AWS SDK v2; no Spring.</description>

    <properties>
        <!-- PIT (mutation testing, ADR-013). Each can be overridden with -D on the command line. -->
        <targetClasses>com.bladebook.core.*</targetClasses>
        <targetTests>com.bladebook.core.*</targetTests>
        <pit.threads>4</pit.threads>
        <pit.mutationThreshold>85</pit.mutationThreshold>
    </properties>

    <dependencies>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>dynamodb</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>apache-client</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>netty-nio-client</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- One HTTP client for the SDK, not the Apache and Netty pair it pulls in by default. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>url-connection-client</artifactId>
        </dependency>

        <!-- Reads the shared cases at the repo root, schedule-cases.json (ADR-013 decision 3b). -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- DynamoDB Local in Docker for the repository and service tests (ADR-013). -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              Mutation testing on core/ only (ADR-013 decision 3). From backend/:
                ./mvnw -pl core test-compile pitest:mutationCoverage
              Report: core/target/pit-reports/index.html. Needs Docker (DynamoDB Local tests).

              targetClasses and targetTests are left out of <configuration> on purpose so the
              properties below set them and -DtargetClasses=... can narrow a run (CI does this
              on pull requests). A value written in <configuration> would ignore -D.
            -->
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <configuration>
                    <threads>${pit.threads}</threads>
                    <timestampedReports>false</timestampedReports>
                    <!-- A PR that only touches an interface or record has nothing to mutate. -->
                    <failWhenNoMutations>false</failWhenNoMutations>
                    <outputFormats>
                        <param>HTML</param>
                        <param>XML</param>
                    </outputFormats>
                    <!-- Fails the build below this score. Raise it as tests improve; never lower it. -->
                    <mutationThreshold>${pit.mutationThreshold}</mutationThreshold>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
